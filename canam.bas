100 REM CAN-AM WAS PROGRAMMED BY MARK MANASSE
110 REM REVISED 12/27/72 BY DIANE MATHER, KIEWIT
120 REM SINGLE-TERMINAL MS-BASIC CONVERSION
130 REM ORIGINAL MULTI-TERMINAL MOTIF FEATURES HAVE BEEN REMOVED
140 REM RACE AGAINST WILDMAN WILLY, HOTSHOT HARRY, AND SLOWPOKE SAM
150 REM THE COURSE IS 5.3 MILES WITH SPEEDS UP TO 200 MPH
160 REM ENTER A SPEED FROM 20 TO 200 FOR EACH TRACK SECTION
170 REM ENTER ZERO TO SEE THE CURRENT STANDINGS
180 REM LOWER ADHESION FACTORS PROVIDE BETTER ROAD GRIP
610 REM PLEASE REFER ORIGINAL BUGS OR COMMENTS TO DIANE MATHER
620 REM PROGRAM LIBRARIAN, 105 KIEWIT
630 DIM A(10),D(10),E(10),H(10),L(10),S(10),T(10)
635 DIM Q(3),Q$(3),M$(3),O$(10)
640 FOR I=1 TO 3:READ Q$(I):NEXT I
650 FOR I=1 TO 3:READ Q(I):NEXT I
660 FOR I=1 TO 3:READ M$(I):NEXT I
670 READ X$
680 DATA "WILDMAN WILLY","HOTSHOT HARRY","SLOWPOKE SAM"
690 DATA -2.9,-2.9,-5
700 DATA "STRAIGHT","HAIRPIN","CURVE"
710 DATA "MAY I SHOW YOU TO A PLOT?  NICE CHOICE OF HEADSTONES."
720 O9=0:O$="":G8=1
730 PRINT "ARE YOU FAMILIAR WITH THE WAY THIS GAME WORKS";
740 INPUT A$
750 IF A$="YES" THEN 900
760 IF A$="NO" THEN 800
770 PRINT "PLEASE ANSWER YES OR NO."
780 GOTO 730
800 PRINT "ENTER A SPEED FROM 20 TO 200 FOR EACH SECTION."
810 PRINT "YOUR CAR MAY CRASH IF YOU TAKE A SECTION TOO FAST."
820 PRINT "RAIN AND OIL REDUCE THE SAFE SPEED."
830 PRINT "ENTER ZERO INSTEAD OF A SPEED TO SEE THE STANDINGS."
840 PRINT
900 PRINT "RATE YOURSELF AS A DRIVER.  (1-BEST, 3-WORST)";
920 INPUT O
930 IF O<1 OR O>3 OR O<>INT(O) THEN 900
940 Q(3)=Q(3)*O
1050 REM INITIALIZE A NEW RACE
1110 F2=INT(RND(0)*10)+6
1115 REM ASSIGN THE HUMAN DRIVER NUMBER AND ADHESION
1120 FOR A=0 TO O9
1130 PRINT "YOUR DRIVING NUMBER IS";F2*(A+1)+A
1140 A(A)=RND(0)*.05+.05
1150 PRINT "ADHESION FACTOR";A(A)*100-5;" .  LOWER IS BETTER."
1160 NEXT A
1170 PRINT "YOUR MAXIMUM SPEED IS 200 MPH."
1180 PRINT "ENTER ZERO AS YOUR SPEED TO SEE THE STANDINGS."
1190 PRINT "WOULD YOU LIKE TO SEE THE COURSE";
1200 INPUT A$
1230 IF A$="NO" THEN 1450
1240 IF A$<>"YES" THEN 1190
1250 REM PRINT THE COURSE WITH EHBASIC'S NATIVE TAB
1260 PRINT TAB(4);"----------------"
1270 PRINT TAB(3);"/1";TAB(11);"B";TAB(19);"2\"
1280 PRINT TAB(2);"/A";TAB(20);"C\"
1290 PRINT TAB(1);"/";TAB(22);"\"
1300 PRINT "/";TAB(21);"3I"
1310 PRINT "^-START*FINISH";TAB(22);"I"
1320 PRINT "^";TAB(22);"I"
1330 PRINT "^";TAB(21);"DI"
1340 PRINT "^";TAB(22);"I"
1350 PRINT "^";TAB(22);"I"
1360 PRINT "^H";TAB(22);"I"
1370 PRINT "^";TAB(22);"I"
1380 PRINT "^";TAB(21);"4I"
1390 PRINT "^";TAB(16);"------/"
1400 PRINT "^8";TAB(15);"(5 E"
1410 PRINT "^";TAB(16);"\"
1420 PRINT "\";TAB(17);"-----------)";TAB(34);"/PITS\"
1430 PRINT " \7";TAB(14);"G";TAB(21);"F^";TAB(27);"6I"
1440 PRINT TAB(2);"\------------------------/"
1450 N=RND(0)*3+1
1460 PRINT "NOTE: THIS IS A";INT(N);" LAP RACE."
1470 PRINT "GENTLEMEN, START YOUR ENGINES!  THE GREEN GOES DOWN AND"
1480 PRINT "OFF YOU GO!"
1490 REM TRACK NAMES AND DEATH MESSAGE WERE READ AT STARTUP
1510 Q=-1:F3=0
1520 H=INT(N)
1530 FOR V=1 TO H
1535 REM TRACK NAME, MAXIMUM, GRIP FACTOR, LENGTH, LABEL CODE
1540 A$=M$(1):R=200:B=1:C=.3:D=65:GOSUB 2300
1550 A$=M$(3):R=125:B=1:C=.1:D=49:GOSUB 2300
1560 A$=M$(1):R=200:B=2:C=.65:D=66:GOSUB 2300
1570 A$=M$(3):R=125:B=1:C=.1:D=50:GOSUB 2300
1580 A$=M$(1):R=200:B=1:C=.2:D=67:GOSUB 2300
1590 A$=M$(3):R=150:B=1:C=.15:D=51:GOSUB 2300
1600 A$=M$(1):R=200:B=2:C=.6:D=68:GOSUB 2300
1610 A$=M$(3):R=125:B=1:C=.1:D=52:GOSUB 2300
1620 A$=M$(1):R=200:B=1:C=.25:D=69:GOSUB 2300
1630 A$=M$(2):R=100:B=.75:C=.15:D=53:GOSUB 2300
1640 A$=M$(1):R=200:B=1.5:C=.45:D=70:GOSUB 2300
1650 A$=M$(2):R=100:B=.75:C=.15:D=54:GOSUB 2300
1660 A$=M$(1):R=200:B=2:C=1:D=71:GOSUB 2300
1670 A$=M$(3):R=125:B=1:C=.1:D=55:GOSUB 2300
1680 A$=M$(3):R=150:B=1:C=.15:D=56:GOSUB 2300
1690 A$=M$(1):R=200:B=2:C=.7:D=72:GOSUB 2300
1700 IF V=H THEN 1740
1710 A$="START-FINISH (CURVE 9)":R=150:B=1:C=.15:D=57
1715 GOSUB 2300
1740 NEXT V
1750 IF G1=1 THEN 2040
1760 PRINT "DO YOU MEAN THAT EVERYONE ISN'T DEAD?"
1765 PRINT "WELL, HERE ARE THE RESULTS FROM THE CHECKERED FLAG:"
1780 W=1E+37
1820 G5=3
1830 FOR Z=0 TO G5
1850 IF Z=0 THEN 1880
1860 PRINT Q$(Z);" ";
1880 PRINT "GUY #";F2*(Z+1)+Z;
1890 IF D(Z)=0 THEN 1950
1900 PRINT " IS LOOKIN' AT THEM PEARLY GATES."
1910 GOTO 1990
1950 PRINT " TOOK";T(Z);" SECONDS.  WHICH AVERAGES OUT TO";
1955 PRINT 3600*5.3*H/T(Z);" MPH"
1960 IF T(Z)>W THEN 1990
1970 W=T(Z)
1980 N=F2*(Z+1)+Z
1990 NEXT Z
2010 IF N>F2 THEN 2040
2020 PRINT "NICE RACE, GUY #";N
2030 PRINT "AND THAT MEANS THAT GUY #";N;" WINS!!!"
2040 PRINT "ANOTHER RACE";
2050 INPUT A$
2080 IF A$="NO" THEN 2290
2090 IF A$<>"YES" THEN 2040
2095 REM RESET DEATH AND TIME ARRAYS FOR THE NEXT RACE
2100 FOR Z=0 TO 10
2110 T(Z)=0:D(Z)=0
2120 NEXT Z
2130 PRINT "NEW SET-UP.  NO RAIN, NO DEBRIS";
2140 IF G1=0 THEN 2160
2150 PRINT ", AND (PLEASE!) BETTER DRIVERS.";
2160 PRINT
2170 G1=0:F5=0
2180 GOTO 1110
2290 STOP
2300 REM PROCESS ONE TRACK SECTION
2310 REM A$=TRACK, R=MAXIMUM, B=GRIP, C=LENGTH, D=LABEL
2330 IF G1=1 THEN 4250
2340 GOSUB 2800
2350 GOSUB 3220
2360 G=0
2370 IF D(G)=1 THEN 2790
2375 REM CHECK THE HUMAN DRIVER'S SAFE SPEED
2380 IF (B+A(G)+E)*S(G)/B<=R*(1+RND(0)*.1) THEN 2500
2390 PRINT X$
2400 F5=F5+1
2410 E(F5)=D
2460 D(G)=1
2470 Q=Q+1
2480 IF Q=O9 THEN 4230
2490 GOTO 2790
2500 Y4=T(G)
2510 IF (B+A(G)+E)*S(G)/B<=R THEN 2530
2520 PRINT "NEARLY HAD TO SAY GOOD BYE."
2530 T(G)=T(G)+C/(S(G)/3600)+L(G)
2545 REM REPORT PASSING BETWEEN THE HUMAN AND AUTOPILOTS
2550 FOR X4=1 TO 3
2560 IF D(X4)=1 THEN 2650
2570 Z4=T(X4)-C/(S(X4)/3600)
2580 Z1=Y4-Z4
2590 Z2=T(G)-T(X4)
2600 IF SGN(Z2)<>-SGN(Z1) THEN 2650
2610 IF SGN(Z2)=1 THEN 2640
2620 PRINT "YOU JUST PASSED ";Q$(X4)
2630 GOTO 2650
2640 PRINT Q$(X4);" JUST PASSED YOU"
2650 NEXT X4
2655 GOTO 2790
2790 GOTO 4250
2800 REM SELECT RAIN, OIL, DEBRIS, AND PIT-STOP HAZARDS
2820 E=0
2830 FOR I=0 TO 10:L(I)=0:NEXT I
2850 IF F5<2 THEN 2900
2860 PRINT "THE RED FLAG HAS BEEN PUT OUT.  CARS REMAIN"
2870 PRINT "MOTIONLESS UNTIL DEBRIS IS CLEARED."
2880 FOR I=0 TO 10:E(I)=0:NEXT I
2890 F5=0
2900 IF F5=0 THEN 2970
2905 FOR X=1 TO F5
2910 IF E(X)=D THEN 2940
2920 NEXT X
2930 GOTO 2970
2940 PRINT "YIKES!  OIL ON THE TRACK!"
2950 E=.2
2960 GOTO 3130
2970 IF F3=1 THEN 3130
2980 IF RND(0)>.025*G8 THEN 3130
2990 IF A(0)<.1 THEN 3080
3000 IF RND(0)>.5 THEN 3130
3010 PRINT "GLORY BE, THE RAIN HAS STOPPED!"
3015 PRINT "BUT REMEMBER THAT THE TRACK IS STILL WET."
3020 F3=1
3030 FOR A=0 TO O9
3040 A(A)=A(A)-.075
3050 G8=.025
3060 NEXT A
3070 GOTO 3130
3080 PRINT "RAIN!  SLOW DOWN!!"
3090 FOR A=0 TO O9
3100 A(A)=A(A)+.1
3110 G8=.1
3120 NEXT A
3130 IF C<>.45 THEN 3210
3140 IF RND(0)<.125 THEN 3210
3150 FOR X=0 TO O9
3160 IF RND(0)<.75 THEN 3200
3170 IF D(X)=1 THEN 3200
3180 L(X)=RND(0)*3+5
3190 PRINT "YOU ARE IN THE PITS FOR:";L(X);" SECONDS."
3200 NEXT X
3210 RETURN
3220 REM INPUT THE HUMAN SPEED AND SET THE AUTOPILOT SPEEDS
3230 FOR I=0 TO 10:S(I)=0:H(I)=0:NEXT I
3240 PRINT A$;" ";CHR$(D);
3250 INPUT S
3490 IF S<=200 THEN 3620
3600 PRINT "MAYBE A LITTLE HARD ON THE PEDAL?  BE REALISTIC."
3613 GOTO 3640
3620 IF S>0 THEN 3660
3630 GOSUB 3990
3640 PRINT "HOW FAST";
3650 INPUT S:GOTO 3490
3660 IF S>=20 THEN 3690
3670 PRINT "I DOUBT YOU WANT TO GO THAT SLOWLY."
3680 GOTO 3640
3690 S(0)=S
3700 GOTO 3760
3760 REM SET SPEEDS FOR THE THREE AUTOPILOTS
3770 FOR F0=1 TO 3
3780 IF D(F0)=1 THEN 3870
3790 S=R*B/(B+.1*E*G8)+(RND(0)*3+Q(F0))
3800 IF (B+.1*G8+E)*S/B<=R THEN 3850
3810 D(F0)=1
3820 PRINT Q$(F0);" JUST WIPED."
3830 F5=F5+1
3840 E(F5)=D
3850 T(F0)=T(F0)+C/(S/3600)
3860 S(F0)=S
3870 NEXT F0
3980 RETURN
3990 REM PRINT CURRENT STANDINGS
4000 A=0:PRINT "YOU ARE";
4020 G5=3
4050 FOR G=0 TO G5
4060 IF G=A THEN 4200
4080 PRINT Q$(G);" IS";
4110 IF D(G)<>1 THEN 4140
4120 PRINT " OUT OF THE RACE."
4130 GOTO 4200
4140 ON SGN(T(A)-T(G))+2 GOTO 4150,4170,4190
4150 PRINT T(G)-T(A);" SECONDS BEHIND YOU."
4160 GOTO 4200
4170 PRINT " RIGHT BESIDE YOU."
4180 GOTO 4200
4190 PRINT T(A)-T(G);" SECONDS AHEAD OF YOU."
4200 NEXT G
4210 PRINT "YOU'VE TAKEN";T(A);" SECONDS."
4220 RETURN
4230 PRINT "YOU, THE LAST OF THE GREAT RACERS, JUST WIPED."
4240 G1=1
4250 RETURN
4260 END
