2040 C$=MID$(P$,T,1)
2041 IF C$=Q$ OR C$="-" THEN 2050
2042 M$=M$+CHR$(J+48)+CHR$(T+48)
2050 NEXT J
2052 IF D<>1 OR M$="" THEN 2060
