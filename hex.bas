2022 M$=M$+CHR$(J+48)+CHR$(T+48)
2025 T=J+D*2
2026 IF T<1 OR T>9 THEN 2035
2027 IF D=1 AND (J=1 OR J=4 OR J=7) THEN 2035
2028 IF D=-1 AND (J=3 OR J=6 OR J=9) THEN 2035
2030 C$=MID$(P$,T,1)
2031 IF C$=Q$ OR C$="-" THEN 2035
2032 M$=M$+CHR$(J+48)+CHR$(T+48)
